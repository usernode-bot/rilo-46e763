{
  "description": "Track your child's first words, animal sounds, and sign language across multiple languages",
  "secrets": [],
  "tests": [
    {
      "name": "Rilo renders on / (welcome or Home)",
      "path": "/",
      "expectSelector": "[data-screen='setup'], [data-screen='app']"
    },
    {
      "id": "rilo.home",
      "name": "Populated demo Home (light)",
      "path": "/?demo=1&un-theme=light",
      "expectSelector": ".hero-count",
      "expectText": "words so far",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "tailwind.config.js",
        "server.js"
      ]
    },
    {
      "name": "Populated demo Home (dark)",
      "path": "/?demo=1&un-theme=dark",
      "expectSelector": "html.dark .kind-card"
    },
    {
      "name": "Insights: growth, languages, mastery and play ideas",
      "path": "/?demo=1&un-theme=light#insights",
      "expectSelector": ".growth-chart",
      "expectText": "Play ideas for this week"
    },
    {
      "name": "Child profile",
      "path": "/?demo=1#profile",
      "expectSelector": ".profile-card",
      "expectText": "Edit child profile"
    },
    {
      "name": "Searchable log grouped by age",
      "path": "/?demo=1#log",
      "expectSelector": "#word-search",
      "expectText": "’s log"
    },
    {
      "name": "Mastery legend on the log",
      "path": "/?demo=1#log",
      "expectSelector": ".legend",
      "expectText": "Practicing"
    }
  ]
}
