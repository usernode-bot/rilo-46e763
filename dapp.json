{
  "description": "Track your child's first words, animal sounds, and sign language across multiple languages",
  "secrets": [],
  "tests": [
    {
      "name": "Rilo renders on / (setup or the firsts list)",
      "path": "/",
      "expectSelector": "[data-screen='setup'], [data-screen='app']"
    },
    {
      "id": "firsts.demo",
      "name": "Populated demo (light)",
      "path": "/?demo=1&un-theme=light",
      "expectSelector": ".kind-card",
      "expectText": "Latest:",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "tailwind.config.js",
        "server.js"
      ]
    },
    {
      "name": "Populated demo (dark)",
      "path": "/?demo=1&un-theme=dark",
      "expectSelector": "html.dark .kind-card"
    },
    {
      "name": "Word insights and monthly chart",
      "path": "/?demo=1&un-theme=light#insights",
      "expectSelector": ".growth-chart",
      "expectText": "What to try next"
    },
    {
      "name": "Child profile",
      "path": "/?demo=1#profile",
      "expectSelector": ".profile-card",
      "expectText": "Edit child profile"
    },
    {
      "name": "Searchable entry collection",
      "path": "/?demo=1#log",
      "expectSelector": "#word-search",
      "expectText": "Word collection"
    }
  ]
}
